      {
       "field": "fwa:norovirus_bug_virus_or_flu",
       "comparator": "equals",
       "value": "yes"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:norovirus_stomach_with_bug_virus_or_flu",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "startsWith",
       "value": "A08.1, A081"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "norov, noro v"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:norovirus_stomach_with_bug_virus_or_flu",
       "comparator": "equals",
       "value": "yes"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:norovirus_cc_and_dd",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "notStartsWith",
       "value": "J10, J11"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10Known",
       "comparator": "equals",
       "value": false
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:norovirus_discharge_diagnosis",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:norovirus_chief_complaint",
       "comparator": "equals",
       "value": "yes"
      },
      {
       "field": "fwa:norovirus_cc_and_dd",
       "comparator": "equals",
       "value": "yes"
      },
      {
       "field": "fwa:norovirus_discharge_diagnosis",
       "comparator": "equals",
       "value": "yes"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:norovirus",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_snomed",
       "comparator": "startsWith",
       "value": "14189004, 417145006, 28463004, 195900001, 74918002, 38921001, 240484000, 240483006, 60013002, 111872008, 444435003, 186562009, 416154000, 426558008, 191727003, 111873003, 230146001, 186561002, 424306000, 13420004, 406592004, 427290009, 427263000, 426654002, 426424002, 427706006, 426091009, 425684000, 425970007, 732209005, 426188007, 426640005, 427073007, 732207007, 426535005, 426028006, 427182003, 732210000, 698204007, 425966004, 416435006, 444974003"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "startsWith",
       "value": "B05"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "measl, meez, mesles, rubeo, measel, measul"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:measles_inclusion",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_snomed",
       "comparator": "startsWith",
       "value": "47435007, 371085006, 150961000119105, 61153008, 150971000119104, 473166002, 703347005, 170433008, 170431005, 432636005, 571591000119106, 170432003, 433733003, 572511000119105, 440075005"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "titer, measles mumps rubella, mmr, vacc, shot, immun, rubel, proph, room b05, german, homesless, rule out measles"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:measles_exclusion",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:measles_inclusion",
       "comparator": "equals",
       "value": "yes"
      },
      {
       "field": "fwa:measles_exclusion",
       "comparator": "notEquals",
       "value": "yes"
      }
     ]
