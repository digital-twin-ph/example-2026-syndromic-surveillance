     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:norovirus_bug_virus_or_flu",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "stomach"
