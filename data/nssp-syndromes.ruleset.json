{
 "schema": "fieldwork/authored-ruleset/1",
 "title": "NSSP syndromes, as published (ICD-10 and SNOMED CT)",
 "mustNotBeReadAs": "a diagnosis or a case: a syndrome definition sorts visits by what was written about them, before anyone has confirmed anything",
 "description": "Transcribed from the National Syndromic Surveillance Program (NSSP) Community of Practice's definitions on the NSSP Knowledge Repository: ILI CCDD v1, CDC Broad Acute Respiratory DD v1, Norovirus v1 and CDC Measles CCDD v1. NSSP and CDC do not endorse Fieldwork or this example. Read with ICD-10 codes, as NSSP's ICD-10-CM codes are written; ICD-9-CM codes left out.",
 "fields": [
  {
   "attribute": "chief_complaint",
   "predicate": "fwa:chief_complaint",
   "kind": "term"
  },
  {
   "attribute": "discharge_diagnosis_icd10",
   "predicate": "fwa:discharge_diagnosis_icd10",
   "kind": "term"
  },
  {
   "attribute": "discharge_diagnosis_snomed",
   "predicate": "fwa:discharge_diagnosis_snomed",
   "kind": "term"
  }
 ],
 "parameters": [],
 "rules": [
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "chill, pyrexia, \" febrile\", high temp, feeling hot, feels hot"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "fever"
      },
      {
       "field": "fwa:chief_complaint",
       "comparator": "notContains",
       "value": "denies fev, shot, afeb, no fev, no temp"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "elevated temp"
      },
      {
       "field": "fwa:chief_complaint",
       "comparator": "notContains",
       "value": "denies any elevated temp, no elevated temp"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "fvr"
      },
      {
       "field": "fwa:chief_complaint",
       "comparator": "notContains",
       "value": "denies fvr, no fvr"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:ili_fever_terms",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "sorethoaat, sorethoart, sorethooat, sorethoort, sorethraat, sorethrart, sorethroat, sorethrort, strep, pharyn, upper resp"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "cough"
      },
      {
       "field": "fwa:chief_complaint",
       "comparator": "notContains",
       "value": "denies cough"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "\"sore \""
      },
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "thoaat, thoart, thooat, thoort, thraat, thrart, throat, thrort"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:ili_respiratory_or_sore_throat_terms",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "flu like, flulike, flu symptom"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_snomed",
       "comparator": "startsWith",
       "value": "442696006, 442438000, 6142004, 195878008"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "startsWith",
       "value": "J09, J10, J11"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "influenza"
      },
      {
       "field": "fwa:chief_complaint",
       "comparator": "notContains",
       "value": "vaccin, shot, immunizat"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "\" flu \""
      },
      {
       "field": "fwa:chief_complaint",
       "comparator": "notContains",
       "value": "shot, stomach, vaccin, immuniza"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:ili_influenza_codes_and_terms",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:ili_fever_terms",
       "comparator": "equals",
       "value": "yes"
      },
      {
       "field": "fwa:ili_respiratory_or_sore_throat_terms",
       "comparator": "equals",
       "value": "yes"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:ili_influenza_codes_and_terms",
       "comparator": "equals",
       "value": "yes"
      },
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "notStartsWith",
       "value": "A08.4, A084"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:ili_influenza_codes_and_terms",
       "comparator": "equals",
       "value": "yes"
      },
      {
       "field": "fwa:discharge_diagnosis_icd10Known",
       "comparator": "equals",
       "value": false
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:ili",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "startsWith",
       "value": "R06.00, R06.02, R0600, R0602"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:broad_respiratory_dyspnea_codes",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "startsWith",
       "value": "R50.9, R509"
