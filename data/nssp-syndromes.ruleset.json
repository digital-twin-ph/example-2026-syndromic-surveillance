     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:broad_respiratory_fever_code",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:discharge_diagnosis_icd10",
       "comparator": "startsWith",
       "value": "A22.1, A221, A37, A48.1, A481, B25.0, B250, B34.2, B34.9, B342, B349, B44.0, B44.9, B440, B449, B44.81, B4481, B97.2, B97.4, B972, B974, J00, J01, J02, J03, J04, J05, J06, J09, J10, J11, J12, J13, J14, J15, J16, J17, J18, J20, J21, J22, J39.8, J398, J40, J47.9, J479, J80, J85.1, J851, J95.821, J95821, J96.0, J96.2, J960, J962, J96.91, J9691, J98.8, J988, R05, R06.03, R0603, R09.02, R0902, R09.2, R092, R43.0, R43.1, R43.2, R430, R431, R432, U07.1, U07.2, U071, U072"
      }
     ]
    },
    {
     "all": [
      {
       "field": "fwa:broad_respiratory_dyspnea_codes",
       "comparator": "equals",
       "value": "yes"
      },
      {
       "field": "fwa:broad_respiratory_fever_code",
       "comparator": "equals",
       "value": "yes"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:broad_respiratory",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "notContains",
       "value": "influenza"
      }
     ]
    }
   ],
   "then": [
    {
     "predicate": "fwa:norovirus_chief_complaint",
     "value": "yes"
    }
   ]
  },
  {
   "any": [
    {
     "all": [
      {
       "field": "fwa:chief_complaint",
       "comparator": "contains",
       "value": "bug, virus, \" flu \""
